# Copy to .env.development / .env.production and fill values.
# npm run dev  → loads .env.development (NODE_ENV=development)
# npm run start → loads .env.production (NODE_ENV=production)

NODE_ENV="development"
PORT="8000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
API_BASE_URL="http://localhost:8000"
ADMIN_RESET_URL="http://localhost:3000/admin/reset-password"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_COOKIE_NAME="weecomi_admin_token"

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="weecomi"
DB_CONNECTION_LIMIT="10"

UPLOAD_DRIVER="local"   
UPLOAD_MAX_IMAGE_MB="10"
LOCAL_UPLOAD_DIR="uploads"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_CDN_URL=""
S3_FORCE_PATH_STYLE="false"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
EMAIL_USER=""
